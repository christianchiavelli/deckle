# Normalise line endings in the repository regardless of the contributor's OS.
# Without this, a Windows checkout commits CRLF and every later diff on Linux
# shows the whole file as changed.
* text=auto eol=lf

# Binary: never normalise, never diff as text.
*.png binary
*.jpg binary
*.webp binary
*.avif binary
*.ico binary
*.woff2 binary

