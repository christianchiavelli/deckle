{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "rootDir": ".",
    "noEmit": true,
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  },
  "include": ["src", "test", "*.config.ts", "*.config.mts"],
  // Dashboard extensions are browser code, checked by the tsconfig.json in their folder.
  "exclude": ["src/plugins/*/dashboard"]
}
