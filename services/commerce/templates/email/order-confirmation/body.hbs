<mjml lang="{{ lang }}">
  <mj-head>
    <mj-title>{{ subject }}</mj-title>
    <mj-preview>{{ preview }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="'Host Grotesk', 'Helvetica Neue', Helvetica, Arial, sans-serif" />
      <mj-section padding="0" />
      <mj-column padding="0" />
      <mj-text padding="0" color="{{ light.text }}" font-size="15px" line-height="1.6" />
      <mj-table padding="0" color="{{ light.text }}" font-size="15px" line-height="1.5" />
    </mj-attributes>
    <mj-raw>
      <meta name="color-scheme" content="light dark" />
      <meta name="supported-color-schemes" content="light dark" />
    </mj-raw>
    <mj-style>
      :root { color-scheme: light dark; supported-color-schemes: light dark; }
      @media (prefers-color-scheme: dark) {
        body, body > div, .band, .band > table { background: {{ dark.band }} !important; }
        .page, .page > table { background: {{ dark.page }} !important; }
        .sheet > table > tbody > tr > td { background: {{ dark.sheet }} !important; }
        .note { background: {{ dark.page }} !important; }
        .deep, .deep > table { border-top: 1px solid {{ dark.stroke }} !important; }
        .primary { color: {{ dark.text }} !important; }
        .secondary { color: {{ dark.secondary }} !important; }
        .chip { background: {{ dark.accentSubtle }} !important; color: {{ dark.accentText }} !important; }
        .seal { background: {{ dark.accent }} !important; color: {{ dark.onAccent }} !important; }
        .rule { border-color: {{ dark.stroke }} !important; }
        .thumb { background: {{ dark.sheet }} !important; }
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="{{ light.band }}" width="600px" css-class="band">
    <mj-wrapper padding="32px 0" background-color="{{ light.band }}" css-class="band">
      <mj-section background-color="{{ light.page }}" css-class="page" padding="36px 40px 0">
        <mj-column>
          <mj-text>
            {{> seal size=30 radius=7 letter=17 gap=12 name=15 background=light.accent ink=light.onAccent text=light.text sealClass="seal" nameClass="primary" }}
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="{{ light.page }}" css-class="page" padding="44px 40px 28px">
        <mj-column>
          <mj-text>
            <span class="chip" style="display:inline-block;padding:3px 10px;border-radius:999px;background:{{ light.accentSubtle }};color:{{ light.accentText }};font-size:13px;font-weight:500;">{{ words.placed }}</span>
          </mj-text>
          <mj-text padding="16px 0 0">
            <h1 class="primary" style="margin:0;font-size:34px;line-height:1.15;font-weight:600;letter-spacing:-0.02em;color:{{ light.text }};">{{ words.thanks }}</h1>
          </mj-text>
          <mj-text padding="14px 0 0">
            <p class="secondary" style="margin:0;font-size:17px;line-height:1.6;color:{{ light.secondary }};">{{ words.lede }}</p>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="{{ light.page }}" css-class="page" padding="0 40px">
        <mj-column>
          <mj-table>
            {{#each lines}}
            <tr>
              <td class="rule" width="64" style="width:64px;padding:18px 0;border-top:1px solid {{ ../light.stroke }};vertical-align:top;">
                <table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;"><tr><td class="thumb" width="64" height="64" align="center" valign="middle" style="width:64px;height:64px;border-radius:10px;background:{{ ../light.sheet }};">{{#if thumb}}<img src="{{ thumb.src }}" alt="" width="{{ thumb.width }}" height="{{ thumb.height }}" style="display:block;width:{{ thumb.width }}px;height:{{ thumb.height }}px;" />{{/if}}</td></tr></table>
              </td>
              <td class="rule" style="padding:18px 0 18px 16px;border-top:1px solid {{ ../light.stroke }};vertical-align:top;">
                <div class="primary" style="font-size:16px;font-weight:600;line-height:1.35;color:{{ ../light.text }};">{{ title }}</div>
                {{#if maker}}<div class="secondary" lang="en" style="padding-top:2px;font-size:13px;color:{{ ../light.secondary }};">{{ maker }}</div>{{/if}}
                <div class="primary" style="padding-top:6px;font-size:13px;color:{{ ../light.text }};">{{ option }}</div>
              </td>
              <td class="rule secondary" style="padding:18px 0 18px 12px;border-top:1px solid {{ ../light.stroke }};vertical-align:top;text-align:right;white-space:nowrap;font-size:14px;color:{{ ../light.secondary }};">{{ quantity }}</td>
              <td class="rule primary" style="padding:18px 0 18px 16px;border-top:1px solid {{ ../light.stroke }};vertical-align:top;text-align:right;white-space:nowrap;font-size:16px;font-weight:600;color:{{ ../light.text }};">{{ total }}</td>
            </tr>
            {{/each}}
          </mj-table>
        </mj-column>
      </mj-section>

      <mj-section background-color="{{ light.page }}" css-class="page" padding="16px 40px 40px">
        <mj-column background-color="{{ light.sheet }}" css-class="sheet" border-radius="16px" padding="28px">
          <mj-text>
            <h2 class="primary" style="margin:0;font-size:19px;line-height:1.3;font-weight:600;color:{{ light.text }};">{{ words.order }}</h2>
          </mj-text>
          <mj-table padding="12px 0 0">
            <tr>
              <td class="secondary" style="padding:6px 0;color:{{ light.secondary }};">{{ words.subtotal }}</td>
              <td class="primary" style="padding:6px 0;text-align:right;white-space:nowrap;color:{{ light.text }};">{{ subtotal }}</td>
            </tr>
            <tr>
              <td class="secondary" style="padding:6px 0 16px;color:{{ light.secondary }};">{{ words.shipping }}</td>
              <td class="primary" style="padding:6px 0 16px;text-align:right;white-space:nowrap;color:{{ light.text }};">{{ shipping }}</td>
            </tr>
            <tr>
              <td class="rule primary" style="padding:16px 0 0;border-top:1px solid {{ light.strokeOnSheet }};font-size:17px;font-weight:600;color:{{ light.text }};">{{ words.total }}</td>
              <td class="rule primary" style="padding:16px 0 0;border-top:1px solid {{ light.strokeOnSheet }};text-align:right;white-space:nowrap;font-size:17px;font-weight:600;color:{{ light.text }};">{{ total }}</td>
            </tr>
          </mj-table>
          {{#if address}}
          <mj-text padding="24px 0 0">
            <div class="secondary" style="font-size:13px;color:{{ light.secondary }};">{{ words.shipTo }}</div>
            <div class="primary" style="padding-top:4px;color:{{ light.text }};">{{ address }}</div>
          </mj-text>
          {{/if}}
          <mj-text padding="16px 0 0">
            <div class="secondary" style="font-size:13px;color:{{ light.secondary }};">{{ words.paid }}</div>
            <div class="primary" style="padding-top:4px;color:{{ light.text }};">{{ words.paidOn }}</div>
          </mj-text>
          <mj-text padding="24px 0 0">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:separate;">
              <tr>
                <td class="note" style="padding:16px 18px;border-radius:12px;background:{{ light.page }};">
                  <div class="primary" style="font-size:14px;font-weight:600;color:{{ light.text }};">{{ words.nothingShipsTitle }}</div>
                  <div class="secondary" style="padding-top:4px;font-size:14px;line-height:1.55;color:{{ light.secondary }};">{{ words.nothingShips }}</div>
                </td>
              </tr>
            </table>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section background-color="{{ light.deep }}" css-class="deep" padding="32px 40px 36px">
        <mj-column>
          <mj-text>
            {{> seal size=24 radius=6 letter=14 gap=10 name=13 background=light.onDeep ink=light.deep text=light.onDeep }}
          </mj-text>
          <mj-text padding="14px 0 0" color="{{ light.onDeepSecondary }}" font-size="13px" line-height="1.55">{{ words.about }}</mj-text>
          <mj-text padding="10px 0 0" color="{{ light.onDeepSecondary }}" font-size="12px" line-height="1.55">{{ words.credit }}</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>
  </mj-body>
</mjml>
