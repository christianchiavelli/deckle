<table role="presentation" cellpadding="0" cellspacing="0" style="border-collapse:collapse;">
  <tr>
    <td class="{{ sealClass }}" width="{{ size }}" height="{{ size }}" align="center" style="width:{{ size }}px;height:{{ size }}px;border-radius:{{ radius }}px;background:{{ background }};color:{{ ink }};font-size:{{ letter }}px;font-weight:700;line-height:{{ size }}px;">D</td>
    <td class="{{ nameClass }}" style="padding-left:{{ gap }}px;font-size:{{ name }}px;font-weight:600;letter-spacing:0.32em;color:{{ text }};">DECKLE</td>
  </tr>
</table>
