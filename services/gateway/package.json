{
  "name": "@deckle/gateway",
  "version": "0.0.0",
  "description": "One GraphQL schema over commerce, the CMS and drops; owns identity and drops",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "drizzle"
  ],
  "scripts": {
    "build": "nest build",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "schema:generate": "nest build && node dist/graphql/schema-cli.js write",
    "schema:check": "nest build && node dist/graphql/schema-cli.js check",
    "schema:diff": "node scripts/schema-diff.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@apollo/server": "catalog:",
    "@as-integrations/express5": "catalog:",
    "@deckle/cache-tags": "workspace:*",
    "@deckle/drops": "workspace:*",
    "@deckle/print-sizes": "workspace:*",
    "@escape.tech/graphql-armor": "catalog:",
    "@nestjs/apollo": "catalog:",
    "@nestjs/common": "catalog:",
    "@nestjs/config": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/graphql": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/terminus": "catalog:",
    "@simplewebauthn/server": "catalog:",
    "dataloader": "catalog:",
    "drizzle-orm": "catalog:",
    "graphql": "catalog:",
    "graphql-query-complexity": "catalog:",
    "graphql-ws": "catalog:",
    "jose": "catalog:",
    "pg": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deckle/eslint-config": "workspace:*",
    "@graphql-inspector/cli": "catalog:",
    "@nestjs/cli": "catalog:",
    "@nestjs/testing": "catalog:",
    "@testcontainers/postgresql": "catalog:",
    "@types/express": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "@types/supertest": "catalog:",
    "@types/ws": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "drizzle-kit": "catalog:",
    "eslint": "catalog:",
    "supertest": "catalog:",
    "testcontainers": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "catalog:"
  }
}
