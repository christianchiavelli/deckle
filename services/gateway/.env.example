# For `pnpm --filter @deckle/gateway start` outside compose: copy to .env and fill in
# the secrets compose uses. The gateway refuses to start while one is missing or shorter
# than 32 characters. Compose publishes no Postgres port: point DATABASE_URL at your own.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://gateway:gateway@localhost:5432/gateway
PUBLIC_ORIGIN=http://localhost:8080
COMMERCE_SHOP_API_URL=http://localhost:8082/shop-api
COMMERCE_ADMIN_API_URL=http://localhost:8082/admin-api
COMMERCE_API_KEY=
CMS_API_URL=http://localhost:8081/api
CMS_API_KEY=
# Equal to the HOOK_SECRET of commerce and of the CMS.
COMMERCE_HOOK_SECRET=
CMS_HOOK_SECRET=
# Optional until the store exists; without it, revalidation is logged and skipped.
STORE_REVALIDATE_URL=
# Shared with the store.
STORE_REVALIDATE_SECRET=
