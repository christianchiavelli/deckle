# Local development only, against the stack `docker compose up --wait` started.
# Compose sets its own values; the secret needs 32+ characters.
GATEWAY_URL=http://localhost:8080/graphql
STORE_REVALIDATE_SECRET=local-only-revalidate-secret-not-for-production
PREVIEW_SECRET=local-only-preview-secret-not-for-production
GATEWAY_PREVIEW_SECRET=local-only-gateway-preview-secret-not-for-production
CMS_PUBLIC_URL=http://localhost:8081
