{
  "name": "@deckle/store",
  "version": "0.0.0",
  "description": "The store: Next.js 16 with Cache Components, reading the gateway on the server and invalidated by its cache tags",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "next typegen && eslint .",
    "test": "vitest run --coverage",
    "codegen": "graphql-codegen --config codegen.ts",
    "schema:check": "graphql-codegen --config codegen.ts --check"
  },
  "dependencies": {
    "@apollo/client": "catalog:",
    "@deckle/brand": "workspace:*",
    "@deckle/cache-tags": "workspace:*",
    "@deckle/print-sizes": "workspace:*",
    "@deckle/tokens": "workspace:*",
    "@deckle/ui": "workspace:*",
    "@payloadcms/live-preview-react": "catalog:",
    "@simplewebauthn/browser": "catalog:",
    "graphql": "catalog:",
    "graphql-ws": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rxjs": "catalog:",
    "styled-components": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deckle/eslint-config": "workspace:*",
    "@graphql-codegen/cli": "catalog:",
    "@graphql-codegen/typed-document-node": "catalog:",
    "@graphql-codegen/typescript-operations": "catalog:",
    "@graphql-typed-document-node/core": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
