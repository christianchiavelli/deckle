# Local development only. Compose sets its own values; secrets need 32+ characters.
DATABASE_URL=postgres://cms:cms@localhost:5432/cms
PORT=3000
PAYLOAD_SECRET=local-only-payload-secret-0000000000000000
GATEWAY_HOOK_URL=http://localhost:4000/hooks/cms
HOOK_SECRET=local-only-hook-secret-000000000000000000
STORE_PREVIEW_URL=http://localhost:8080/api/preview
PREVIEW_SECRET=local-only-preview-secret-00000000000000
# Read by the seed only.
GATEWAY_API_KEY=local-only-gateway-api-key-0000000000000
ADMIN_EMAIL=admin@deckle.local
ADMIN_PASSWORD=local-only-admin-password
