**/.next
**/dist
**/coverage
**/*.tsbuildinfo
**/.env
**/.env.*
!**/.env.example
.git
data
design
services
packages/met
packages/print-sizes
apps/cms/media
apps/cms/src/**/*.spec.ts
apps/cms/src/test
