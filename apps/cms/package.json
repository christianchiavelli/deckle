{
  "name": "@deckle/cms",
  "version": "0.0.0",
  "description": "Payload in its own Next.js app: each work's story, curated collections, drop pages and draft preview",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build && esbuild src/seed/main.ts --bundle --platform=node --format=esm --target=node24 --outfile=dist/seed.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "seed": "tsx --env-file-if-exists=.env src/seed/main.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "migrate:create": "payload migrate:create"
  },
  "dependencies": {
    "@deckle/brand": "workspace:*",
    "@deckle/tokens": "workspace:*",
    "@payloadcms/db-postgres": "catalog:",
    "@payloadcms/next": "catalog:",
    "@payloadcms/richtext-lexical": "catalog:",
    "@payloadcms/translations": "catalog:",
    "@payloadcms/ui": "catalog:",
    "graphql": "catalog:",
    "next": "catalog:",
    "payload": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sharp": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@deckle/eslint-config": "workspace:*",
    "@testcontainers/postgresql": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "testcontainers": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
