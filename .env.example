# Copy to `.env` to override what `compose.yaml` defaults. Nothing here is
# needed to run Deckle on a laptop: every value already has a local default.

# Which published build to run: `latest` on main, or `sha-<7 characters>`.
DECKLE_TAG=latest

# Two gateway replicas, for the drop's load test.
GATEWAY_REPLICAS=1

# Shared between services, so each pair must match. Every secret needs at
# least 32 characters, or the service that reads it refuses to start.
COMMERCE_HOOK_SECRET=local-only-commerce-hook-secret-not-for-production
CMS_HOOK_SECRET=local-only-cms-hook-secret-not-for-production
# Vendure's format: a lookup id, a colon, then the secret.
COMMERCE_API_KEY=deckle-gateway:local-only-commerce-api-key-not-for-production
CMS_API_KEY=local-only-cms-api-key-not-for-production

# Sign-ins for the two admin screens. Both want a password of at least 12
# characters, and the CMS a real email address.
COMMERCE_SUPERADMIN_USERNAME=superadmin
COMMERCE_SUPERADMIN_PASSWORD=deckle-superadmin
CMS_ADMIN_EMAIL=editor@deckle.localhost
CMS_ADMIN_PASSWORD=deckle-editor

POSTGRES_PASSWORD=postgres
PAYLOAD_SECRET=local-only-payload-secret-not-for-production
PREVIEW_SECRET=local-only-preview-secret-not-for-production
GATEWAY_PREVIEW_SECRET=local-only-gateway-preview-secret-not-for-production
STORE_REVALIDATE_SECRET=local-only-revalidate-secret-not-for-production
