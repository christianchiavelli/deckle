# Copy to `.env` to override what `compose.yaml` defaults. Nothing here is
# needed to run Deckle on a laptop: every value already has a local default.

# Which published build to run: `latest` on main, or `sha-<7 characters>`.
DECKLE_TAG=latest

# Two gateway replicas, for the drop's load test.
GATEWAY_REPLICAS=1

# Shared between services, so each pair must match.
COMMERCE_HOOK_SECRET=local-only-commerce-hook-secret
CMS_HOOK_SECRET=local-only-cms-hook-secret
COMMERCE_API_KEY=local-only-commerce-api-key
CMS_API_KEY=local-only-cms-api-key

# Sign-ins for the two admin screens.
COMMERCE_SUPERADMIN_USERNAME=superadmin
COMMERCE_SUPERADMIN_PASSWORD=superadmin
CMS_ADMIN_EMAIL=editor@deckle.localhost
CMS_ADMIN_PASSWORD=deckle-editor

POSTGRES_PASSWORD=postgres
PAYLOAD_SECRET=local-only-payload-secret
PREVIEW_SECRET=local-only-preview-secret
STORE_REVALIDATE_SECRET=local-only-revalidate-secret
