  --text-on-accent: light-dark(var(--p-color-paper-0), var(--p-color-bistre-950));
  --icon-primary: light-dark(var(--p-color-bistre-950), var(--p-color-bistre-100));
  --icon-secondary: light-dark(var(--p-color-bistre-600), var(--p-color-bistre-300));
  --icon-accent: light-dark(var(--p-color-copper-600), var(--p-color-copper-400));
  --stroke-subtle: light-dark(var(--p-color-paper-100), var(--p-color-bistre-800));
  --stroke-default: light-dark(var(--p-color-paper-300), var(--p-color-bistre-700));
  --stroke-strong: light-dark(var(--p-color-bistre-950), var(--p-color-bistre-100));
  --stroke-accent: light-dark(var(--p-color-copper-600), var(--p-color-copper-400));
  --action-primary: light-dark(var(--p-color-bistre-950), var(--p-color-paper-0));
