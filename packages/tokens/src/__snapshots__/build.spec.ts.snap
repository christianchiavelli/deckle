  --type-body-small-tracking: var(--p-font-tracking-none);
  --type-caption-family: var(--p-font-family-text);
  --type-caption-size: var(--p-font-size-13);
  --type-caption-weight: var(--p-font-weight-400);
  --type-caption-leading: var(--p-font-leading-normal);
  --type-caption-tracking: var(--p-font-tracking-none);
  --type-label-family: var(--p-font-family-text);
  --type-label-size: var(--p-font-size-14);
  --type-label-weight: var(--p-font-weight-600);
  --type-label-leading: var(--p-font-leading-snug);
  --type-label-tracking: var(--p-font-tracking-label);
  --type-numeral-family: var(--p-font-family-numeral);
  --type-numeral-size: var(--p-font-size-56);
  --type-numeral-weight: var(--p-font-weight-600);
  --type-numeral-leading: var(--p-font-leading-solid);
  --type-numeral-tracking: var(--p-font-tracking-display);
  --space-gap-2xs: var(--p-space-4);
  --space-gap-xs: var(--p-space-8);
  --space-gap-sm: var(--p-space-12);
  --space-gap-md: var(--p-space-16);
  --space-gap-lg: var(--p-space-24);
  --space-gap-xl: var(--p-space-32);
  --space-gap-2xl: var(--p-space-48);
  --space-gap-3xl: var(--p-space-64);
  --space-section: var(--p-space-96);
  --space-section-tight: var(--p-space-64);
  --radius-control: var(--p-radius-control);
  --radius-frame: var(--p-radius-frame);
  --radius-chip: var(--p-radius-round);
  --stroke-width-hairline: var(--p-stroke-width-hairline);
  --stroke-width-rule: var(--p-stroke-width-rule);
  --layout-max-width: var(--p-grid-max-width);
  --layout-gutter: var(--p-grid-gutter);
  --layout-columns: var(--p-grid-columns);
  --motion-feedback: var(--p-motion-duration-quick);
  --motion-enter: var(--p-motion-duration-moderate);
  --motion-exit: var(--p-motion-duration-quick);
  --motion-easing: var(--p-motion-easing-standard);
}

/* A choice the reader made overrides the system's. */
:root[data-theme='light'] {
  color-scheme: light;
}

:root[data-theme='dark'] {
  color-scheme: dark;
}
"
`;
