  --accent-default: light-dark(var(--p-color-copper-600), var(--p-color-copper-400));
  --accent-subtle: light-dark(var(--p-color-copper-50), var(--p-color-copper-950));
  --focus-ring: light-dark(var(--p-color-copper-600), var(--p-color-copper-300));
  --feedback-success: light-dark(var(--p-color-green-600), var(--p-color-green-300));
  --feedback-error: light-dark(var(--p-color-red-600), var(--p-color-red-300));
  --feedback-warning: light-dark(var(--p-color-amber-600), var(--p-color-amber-300));
