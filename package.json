{
  "name": "deckle",
  "version": "0.1.0",
  "description": "A headless print shop for public-domain works from The Met, with numbered drops that never oversell",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "screenshots": "pnpm --filter @deckle/e2e run screenshots"
  },
  "devDependencies": {
    "prettier": "catalog:",
    "typescript": "catalog:"
  }
}
